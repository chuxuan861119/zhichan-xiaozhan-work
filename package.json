{
  "name": "zhichan-xiaozhan-work",
  "version": "2.2.0",
  "private": true,
  "description": "面向中国专利撰写的专业编辑器",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "check:dependencies": "node scripts/check-installed-dependencies.cjs",
    "predev": "npm run check:dependencies && npm run build:design-editor",
    "dev": "electron-vite dev",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "check": "biome check .",
    "check:app": "biome check --config-path biome.app.json .",
    "check:fix": "biome check --write .",
    "pretest:unit": "npm run check:dependencies",
    "test:unit": "vitest run --pool=forks --maxWorkers=1",
    "pretest:unit:watch": "npm run check:dependencies",
    "test:unit:watch": "vitest",
    "prebuild:app": "npm run check:dependencies",
    "build:app": "npm run build:cli && electron-vite build && npm run build:design-editor",
    "generate:icon": "node build/generate-icon.mjs",
    "vendor:drawings": "python tools/drawing-converter/prepare_runtime.py",
    "vendor:cad": "node scripts/build-cadcraft.mjs",
    "audit:drawings": "node scripts/audit-drawing-converter.mjs",
    "vendor:drawio": "node scripts/vendor-drawio.mjs",
    "audit:drawio": "node scripts/audit-drawio-bundle.mjs",
    "measure:flowchart-bundle": "node scripts/measure-flowchart-bundle.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "test:release-evidence": "node --test scripts/release-evidence.test.mjs",
    "release:evidence": "node scripts/release-evidence.mjs",
    "prebuild": "npm run check:dependencies",
    "build": "npm run check:app && npm run typecheck && npm run test:unit && npm run build:app",
    "test:e2e": "npm run build:app && playwright test --grep-invert @performance --workers=1",
    "test:performance": "npm run build:app && playwright test --grep @performance --workers=1",
    "dist:win": "npm run build && npm run generate:icon && npm run audit:licenses && npm run audit:drawings -- win-x64 && npm run vendor:cli && electron-builder --win nsis --x64",
    "dist:mac": "node scripts/dist-mac.mjs",
    "dist:mac:local": "node scripts/dist-mac.mjs --local",
    "dist:harmony": "node scripts/dist-harmony.mjs",
    "dist:harmony:local": "node scripts/dist-harmony.mjs --local",
    "test:harmony-build": "node --test scripts/harmony-build.test.mjs",
    "vendor:mac-tools": "node scripts/build-mac-tools.mjs",
    "verify:mac": "node scripts/verify-mac.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "cli": "node out/cli/index.cjs",
    "vendor:cli": "node scripts/vendor-cli-runtime.mjs",
    "build:usage-service": "node scripts/build-usage-service.mjs",
    "verify:source-release": "node scripts/verify-open-source-release.mjs",
    "build:design-editor": "node scripts/build-klecks-editor.mjs",
    "preaudit:licenses": "install-electron"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-character-count": "3.31.4",
    "@tiptap/extension-color": "3.31.4",
    "@tiptap/extension-file-handler": "3.31.4",
    "@tiptap/extension-font-family": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-mathematics": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/extension-unique-id": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@xmldom/xmldom": "0.9.12",
    "ag-psd": "31.0.1",
    "docx": "9.7.1",
    "dompurify": "3.4.17",
    "file-type": "22.0.1",
    "katex": "0.17.0",
    "ketcher-core": "3.17.1",
    "ketcher-react": "3.17.1",
    "ketcher-standalone": "3.17.1",
    "lucide-react": "1.28.0",
    "mathjax-full": "3.2.2",
    "mathlive": "0.110.0",
    "mathml-to-latex": "1.8.0",
    "pdfjs-dist": "6.2.108",
    "polygon-clipping": "0.15.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "transformation-matrix": "3.1.0",
    "write-file-atomic": "7.0.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/write-file-atomic": "4.0.3",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "electron": "43.8.7",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "js-beautify": "1.15.4",
    "jsdom": "29.0.1",
    "json5": "2.2.3",
    "typescript": "7.0.2",
    "vite": "7.3.8",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@electron/get": "5.1.0",
    "@xmldom/xmldom@>=0.9.0": "$@xmldom/xmldom",
    "polygon-clipping": {
      "robust-predicates": "3.0.2",
      "splaytree": "3.1.2"
    }
  },
  "license": "GPL-3.0-only",
  "homepage": "https://zcxzz.cn/work/",
  "repository": {
    "type": "git",
    "url": "https://github.com/chuxuan861119/zhichan-xiaozhan-work.git"
  }
}
