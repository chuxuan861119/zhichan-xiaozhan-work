{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!out-*",
      "!build/icon.svg",
      "!docs/patent-feature-board.html",
      "!resources/drawio/app",
      "!resources/ipc-data-center",
      "!tests/fixtures/vector-image/patent-black-output.svg",
      "!tests/fixtures/vector-image/render-reference.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
